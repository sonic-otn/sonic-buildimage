
SPATH       := $($(SONIC_OLS)_SRC_PATH)
DEP_FILES   := $(SONIC_COMMON_FILES_LIST) rules/ols.mk rules/ols.dep   
DEP_FILES   += $(SONIC_COMMON_BASE_FILES_LIST)
DEP_FILES := $(addprefix $(SPATH)/,$(shell cd $(SPATH) && git ls-files))

$(SONIC_OLS)_CACHE_MODE  := GIT_CONTENT_SHA 
$(SONIC_OLS)_DEP_FLAGS   := $(SONIC_COMMON_FLAGS_LIST)
$(SONIC_OLS)_DEP_FILES   := $(DEP_FILES)
