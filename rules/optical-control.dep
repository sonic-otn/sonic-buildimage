
SPATH       := $($(SONIC_OPTICAL_CONTROL)_SRC_PATH)
DEP_FILES   := $(SONIC_COMMON_FILES_LIST) rules/optical-control.mk rules/optical-control.dep   
DEP_FILES   += $(SONIC_COMMON_BASE_FILES_LIST)
DEP_FILES := $(addprefix $(SPATH)/,$(shell cd $(SPATH) && git ls-files))

$(SONIC_OPTICAL_CONTROL)_CACHE_MODE  := GIT_CONTENT_SHA 
$(SONIC_OPTICAL_CONTROL)_DEP_FLAGS   := $(SONIC_COMMON_FLAGS_LIST)
$(SONIC_OPTICAL_CONTROL)_DEP_FILES   := $(DEP_FILES)
