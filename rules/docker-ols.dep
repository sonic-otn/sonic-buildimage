
DPATH       := $($(DOCKER_OLS)_PATH)
DEP_FILES   := $(SONIC_COMMON_FILES_LIST) rules/docker-ols.mk rules/docker-ols.dep   
DEP_FILES   += $(SONIC_COMMON_BASE_FILES_LIST)
DEP_FILES   += $(shell git ls-files $(DPATH))

$(DOCKER_OLS)_CACHE_MODE  := GIT_CONTENT_SHA 
$(DOCKER_OLS)_DEP_FLAGS   := $(SONIC_COMMON_FLAGS_LIST)
$(DOCKER_OLS)_DEP_FILES   := $(DEP_FILES)

$(eval $(call add_dbg_docker,$(DOCKER_OLS),$(DOCKER_OLS_DBG)))
