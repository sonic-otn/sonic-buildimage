[
    {
        "tag": "otn-alarm",
        "regex": ".*, (CRITICAL|MAJOR|MINOR|WARNING|INFORMATIONAL), (\\S+), ([^,]+), (.+), (RAISE|CLEAR)",
        "params": [ "severity", "resource", "type-id", "text", "action" ]
    },
    {
        "tag": "otn-event",
        "regex": ".*, (CRITICAL|MAJOR|MINOR|WARNING|INFORMATIONAL), (\\S+), ([^,]+), (.+)",
        "params": [ "severity", "resource", "type-id", "text" ]
    }
]
