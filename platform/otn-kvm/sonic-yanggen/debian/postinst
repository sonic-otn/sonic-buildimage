#!/bin/sh
set -e

case "$1" in
    configure)
        # Enable and start the sonic-yanggen service
        if [ -d /run/systemd/system ]; then
            systemctl --system daemon-reload >/dev/null || true
            if ! systemctl is-enabled sonic-yanggen.service >/dev/null 2>&1; then
                systemctl enable sonic-yanggen.service >/dev/null || true
            fi
            # Start the service on installation
            systemctl start sonic-yanggen.service >/dev/null || true
        fi
        ;;
    
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0

